# EcoPackAI - environment settings (copy to .env and edit; .env is not committed)
# Full list and defaults: backend/settings.py

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=5000

# Database: leave empty for the SQLite file instance/ecopackai.db
# PostgreSQL example: postgresql://ecopack_user:ecopack_pass@localhost:5432/ecopackai_db
DATABASE_URL=

# API keys (comma-separated). Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without keys the API runs WITHOUT authentication in development and refuses to start in production.
API_KEYS=change-me-client-key
ADMIN_API_KEYS=change-me-admin-key

CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1024

LOG_DIR=logs
LOG_LEVEL=INFO
